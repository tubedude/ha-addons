#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Starts tailscaled and publishes mosquitto's TLS listener over Funnel.
#
# Why TCP and not HTTP: with `funnel --tcp` TLS terminates HERE, at mosquitto's
# own 8884 listener — so require_certificate applies end to end. Were Funnel
# proxying HTTP, TLS would terminate at Tailscale's edge and the broker would
# never see the client certificate.
# ==============================================================================

if ! bashio::config.has_value 'tailscale_authkey'; then
    bashio::log.info "tailscale_authkey not set — Tailscale disabled"
    # do not take the add-on down: local mosquitto keeps working
    exec sleep infinity
fi

mkdir -p /data/tailscale /dev/net
if [ ! -c /dev/net/tun ]; then
    mknod /dev/net/tun c 10 200 || bashio::log.warning "no /dev/net/tun — falling back to userspace"
fi

bashio::log.info "Starting tailscaled..."
# userspace-networking avoids needing NET_ADMIN, which add-ons lack
tailscaled \
    --state=/data/tailscale/tailscaled.state \
    --socket=/var/run/tailscale/tailscaled.sock \
    --tun=userspace-networking &
TSD_PID=$!

# wait for the socket before talking to the daemon
for _ in $(seq 1 30); do
    [ -S /var/run/tailscale/tailscaled.sock ] && break
    sleep 1
done

HOSTNAME=$(bashio::config 'tailscale_hostname' 'mosquitto')
bashio::log.info "Authenticating as '${HOSTNAME}'..."
tailscale --socket=/var/run/tailscale/tailscaled.sock up \
    --authkey="$(bashio::config 'tailscale_authkey')" \
    --hostname="${HOSTNAME}" \
    --accept-dns=false \
    || bashio::log.error "tailscale up failed"

# Wait for mosquitto to answer on 8884 (TLS) before publishing the Funnel —
# publishing at a dead port leaves a broken endpoint.
PORT=$(bashio::config 'tailscale_funnel_port' '8443')
for _ in $(seq 1 60); do
    (echo > /dev/tcp/127.0.0.1/8884) >/dev/null 2>&1 && break
    sleep 1
done

if (echo > /dev/tcp/127.0.0.1/8884) >/dev/null 2>&1; then
    bashio::log.info "Publishing Funnel TCP :${PORT} -> mosquitto 8884 (wss)"
    tailscale --socket=/var/run/tailscale/tailscaled.sock \
        funnel --bg --tcp="${PORT}" tcp://127.0.0.1:8884 \
        || bashio::log.error "funnel failed — needs TLS certs in the add-on (certfile/keyfile) and the 'funnel' node attribute on the tailnet"
    tailscale --socket=/var/run/tailscale/tailscaled.sock funnel status || true
else
    bashio::log.error "TLS listener 8884 never came up — without a certificate there is nothing to publish"
fi

wait "${TSD_PID}"
